@page
@model Moto_Taxi_Maintenance_Tracker.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "Manage Users";
}

<h1>Manage Users</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">+ Add User</a>
</p>

@if (!Model.Users.Any())
{
    <p class="text-muted">No users found.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Full Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Created</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Users)
            {
                <tr>
                    <td>@user.FullName</td>
                    <td>@user.Email</td>
                    <td><span class="badge bg-secondary">@user.Role</span></td>
                    <td>@user.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                    <td>
                        <a asp-page="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-page="Delete" asp-route-id="@user.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
