@page "{id:int}"
@model Moto_Taxi_Maintenance_Tracker.Pages.Garages.DeleteModel
@{
    ViewData["Title"] = "Delete Garage";
}

<h1>Delete Garage</h1>

<p>Are you sure you want to delete this garage?</p>

<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Garage.Name</dd>

    <dt class="col-sm-3">Location</dt>
    <dd class="col-sm-9">@Model.Garage.Location</dd>
</dl>

<form method="post">
    <input type="hidden" asp-for="Garage.Id" />
    <button type="submit" class="btn">Delete</button>
    <a asp-page="Index" class="btn">Cancel</a>
</form>
