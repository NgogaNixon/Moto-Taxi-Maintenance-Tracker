@page
@model Moto_Taxi_Maintenance_Tracker.Pages.Motorcycles.IndexModel
@{
    ViewData["Title"] = "Motorcycles";
}

<h1>Motorcycles</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">+ Register Motorcycle</a>
</p>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="SearchPlate" value="@Model.SearchPlate" class="form-control" placeholder="Search by plate number..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Search</button>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.SearchPlate))
    {
        <div class="col-auto">
            <a asp-page="Index" class="btn btn-link">Clear</a>
        </div>
    }
</form>

@if (!Model.Motorcycles.Any())
{
    <p class="text-muted">No motorcycles found.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Plate Number</th>
                <th>Model</th>
                <th>Year</th>
                <th>Owner</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var moto in Model.Motorcycles)
            {
                <tr>
                    <td>@moto.PlateNumber</td>
                    <td>@moto.Model</td>
                    <td>@moto.Year</td>
                    <td>@(moto.Owner?.FullName ?? "—")</td>
                    <td>
                        <a asp-page="Edit" asp-route-id="@moto.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-page="Delete" asp-route-id="@moto.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
