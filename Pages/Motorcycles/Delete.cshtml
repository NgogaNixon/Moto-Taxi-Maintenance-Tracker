@page "{id:int}"
@model Moto_Taxi_Maintenance_Tracker.Pages.Motorcycles.DeleteModel
@{
    ViewData["Title"] = "Delete Motorcycle";
}

<h1>Delete Motorcycle</h1>

<p>Are you sure you want to delete this motorcycle?</p>

<dl class="row">
    <dt class="col-sm-3">Plate Number</dt>
    <dd class="col-sm-9">@Model.Motorcycle.PlateNumber</dd>

    <dt class="col-sm-3">Model</dt>
    <dd class="col-sm-9">@Model.Motorcycle.Model</dd>

    <dt class="col-sm-3">Year</dt>
    <dd class="col-sm-9">@Model.Motorcycle.Year</dd>

    <dt class="col-sm-3">Owner</dt>
    <dd class="col-sm-9">@(Model.Motorcycle.Owner?.FullName ?? "—")</dd>
</dl>

<form method="post">
    <input type="hidden" asp-for="Motorcycle.Id" />
    <button type="submit" class="btn">Delete</button>
    <a asp-page="Index" class="btn">Cancel</a>
</form>
