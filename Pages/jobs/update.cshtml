@page "{id:int}"
@model Moto_Taxi_Maintenance_Tracker.Pages.Jobs.UpdateModel

@{
    ViewData["Title"] = "Update Repair Job";
}

<h2>Update Repair Job</h2>

<form method="post">

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label class="form-label">Repair Status</label>

        <select asp-for="Repair.Status" class="form-select">
            <option value="Assigned">Assigned</option>
            <option value="In Progress">In Progress</option>
            <option value="Completed">Completed</option>
        </select>

        <span asp-validation-for="Repair.Status" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Repair.RepairNotes" class="form-label">
            Repair Notes
        </label>

        <textarea asp-for="Repair.RepairNotes"
                  class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="Repair.LabourCost" class="form-label">
            Labour Cost
        </label>

        <input asp-for="Repair.LabourCost"
               type="number"
               step="0.01"
               min="0"
               class="form-control" />

        <span asp-validation-for="Repair.LabourCost"
              class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">
        Save Changes
    </button>

    <a asp-page="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>